{
  "version": 2,
  "installCommand": "npx --yes pnpm@10.26.1 install --no-frozen-lockfile",
  "buildCommand": "npx pnpm@10.26.1 --filter @workspace/viralstore run build",
  "outputDirectory": "artifacts/viralstore/dist",
  "framework": null,
  "routes": [
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
